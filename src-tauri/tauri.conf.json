{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cburn",
  "version": "0.1.2",
  "identifier": "com.cloudo.cburn",
  "build": {
    "frontendDist": "http://127.0.0.1:8799",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix web run dev"
  },
  "app": {
    "windows": [
      {
        "title": "cburn",
        "width": 1180,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
